# Copy to config.env and fill in. Never commit config.env — it holds a live bot token.

# Token from @BotFather (create a bot with /newbot)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat ids allowed to talk to the bot (DM id or group id,
# groups are negative numbers like -100xxxxxxxxxx). Message the bot and check
# bridge.log to find a chat's id if you don't know it yet.
ALLOWED_CHAT_IDS=

# Working directory Claude Code runs in — this is the project the bot can see/edit.
WORKSPACE=/path/to/your/project

# Absolute path to the claude binary. systemd's PATH is minimal and usually won't
# find it — run `which claude` to get this.
CLAUDE_BIN=/usr/bin/claude

# claude --permission-mode. 'plan' (default) is read/analyze only, no changes.
# Only loosen this if you understand what the bot will then be able to do
# unattended — see the Security section in README.md.
PERMISSION_MODE=plan

# Optional: pin a specific model instead of Claude Code's default.
# CLAUDE_MODEL=

# Optional: session transcript size (bytes) that triggers a rollover to a fresh
# session. Default 750000. Lower it if your per-message cost is climbing.
# MAX_SESSION_BYTES=750000

# Optional: cheaper model used to write the rollover handoff summary.
# SUMMARY_MODEL=
